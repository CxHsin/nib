{
  "name": "nib",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "start-all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "send-now": "node --env-file-if-exists=.env --import tsx src/send-now.ts",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@tiny-fish/sdk": "0.7.0",
    "html-to-text": "9.0.5",
    "typebox": "1.3.34",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
