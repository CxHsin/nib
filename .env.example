# NapCat 正向 WebSocket 地址；在 NapCat WebUI 中启用后填写。
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=
# 可选；默认使用 D:\Code\NapCat\launcher.bat
NAPCAT_LAUNCHER_BAT=D:\Code\NapCat\launcher.bat
# 逗号分隔。第一版建议各填一个，验证后再扩展。
QQ_GROUP_IDS=
 # QQ_AUTHOR_IDS 已弃用：指定群全员采集。
# 群内对话的唯一触发者：填写你自己的 QQ 号（不是机器人 QQ 号）。留空关闭对话。
QQ_OWNER_ID=

# 可选：让晚报显示易读群名。键为群号。
QQ_GROUP_NAMES={"":""}

DEEPSEEK_API_KEY=
PI_MODEL=deepseek-v4-pro

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 可选配置
DATA_DIR=./data
MAX_AGENT_TOOL_CALLS=20

# 可选，启用群内 web_search（也可使用用户环境变量）
TINYFISH_API_KEY=
